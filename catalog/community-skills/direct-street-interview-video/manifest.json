  "creative_dna": {
    "mechanism": "单一社交前提驱动连续街道路线上人物与镜头的距离变化；表演、视差、移动自然光和现场声共同把关系推进到可读结尾。",
    "applicable_scope": [
      "街头采访、偶遇、城市漫步和人物介绍",
      "服装、美妆、旅行与生活方式短片",
      "需要保持人物身份和服装稳定的 H3 Ref2VA 或 Seedance 多模态参考",
      "4–15 秒内可由一个连续动作链讲清的互动"
    ],
    "not_suitable_for": [
      "大段口播、复杂辩论或多地点群戏",
      "精密舞蹈、大量硬切或逐帧复刻真人与地点",
      "未经明确要求的陌生人肢体接触"
    ],
    "usage_steps": [
      "明确互动目的、时长、画幅、人物关系、路线和结尾",
      "为每个输入素材分配唯一且狭窄的身份、服装、环境、动作或声音职责",
      "先写接近—交流—关系变化—落点的因果链，再决定是否切镜",
      "按时长删减对白，并分别用 H3 与 Seedance 原生语法编译",
      "检查身份、步态、路线、光影、手部接触、声音与时间闭包"
    ],
    "invariants": [
      "开场立即建立互动理由",
      "镜头跟随人物地理而运动",
      "距离、步态、视线或手势至少发生一次可见变化",
      "环境视差、光影和现场声保持连续",
      "结尾是可读状态而不是突然截断"
    ],
    "quality_repairs": [
      "所有事件必须落在实际目标时长内",
      "10 秒优先两到三句短对白，先删对白再加速语速",
      "不从片尾才开始第二镜头",
      "默认用语言或手势定位，肢体接触必须明确、合意且物理可执行",
      "不以虚构 4K 标签代替动作、光影和空间设计"
    ],
    "anti_copy_exclusions": [
      "不复制样片人物外貌、服装和身体造型",
      "不复制原树荫街道、围栏道路构图和对白",
      "至少同时改变人物类型、关系、地点、路线、服装、对白、镜头实现和结尾中的六项"
    ]
  },
